---
import { GISCUS } from '../config';

const on = Boolean(GISCUS.repo && GISCUS.repoId && GISCUS.categoryId);
---

{
  on && (
    <div class="comments" id="comments" data-giscus={JSON.stringify(GISCUS)}>
      <script is:inline>
        (() => {
          const host = document.getElementById('comments');
          const cfg = JSON.parse(host.dataset.giscus);
          const themeOf = () =>
            document.documentElement.dataset.theme === 'dark'
              ? 'transparent_dark'
              : 'light';

          const s = document.createElement('script');
          s.src = 'https://giscus.app/client.js';
          s.async = true;
          s.crossOrigin = 'anonymous';
          Object.entries({
            repo: cfg.repo,
            'repo-id': cfg.repoId,
            category: cfg.category,
            'category-id': cfg.categoryId,
            mapping: 'pathname',
            strict: '1',
            'reactions-enabled': '1',
            'emit-metadata': '0',
            'input-position': 'top',
            theme: themeOf(),
            lang: 'ko',
            loading: 'lazy',
          }).forEach(([k, v]) => s.setAttribute('data-' + k, v));
          host.appendChild(s);

          document.addEventListener('themechange', () => {
            const frame = document.querySelector('iframe.giscus-frame');
            if (!frame) return;
            frame.contentWindow.postMessage(
              { giscus: { setConfig: { theme: themeOf() } } },
              'https://giscus.app'
            );
          });
        })();
      </script>
    </div>
  )
}
